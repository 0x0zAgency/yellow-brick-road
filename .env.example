# No wallet, private key or RPC secret needed for local tests.

# Optional launcher environment settings; the dashboard needs no RPC URL input.
# Infura shared development access is the Sepolia default. For your own quota:
# export INFURA_API_KEY=<your-project-key>
# Or retain an explicitly configured operator endpoint:
# export SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
# Never prefix private endpoints or service keys with VITE_ or commit real values.
# This file is documentation, not automatically sourced by npm run dev.
