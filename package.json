{
  "name": "@0x0z/yellow-brick-road",
  "version": "0.2.0",
  "private": true,
  "description": "Independent intellectual property protocol prototype",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "demo": "hardhat run scripts/demo.js",
    "clean": "hardhat clean",
    "preganache": "node scripts/dev-ganache-storage.cjs",
    "ganache": "node scripts/dev-ganache.cjs",
    "ganache:smoke": "hardhat run scripts/ganache-smoke.js --network ganache",
    "ganache:test": "hardhat test --network ganache",
    "sepolia:check": "hardhat run scripts/sepolia-check.js --network sepolia",
    "ganache:deploy": "hardhat run scripts/deploy-local.js --network ganache",
    "test:wallet": "npm run compile && node --test web/integration/ganache-wallet.test.js web/integration/chain-history.test.js web/integration/content-policy.test.js",
    "ipfs:up": "docker compose -f infra/ipfs/compose.yaml up -d",
    "ipfs:down": "docker compose -f infra/ipfs/compose.yaml down",
    "ipfs:status": "docker compose -f infra/ipfs/compose.yaml ps",
    "ipfs:bridge": "node web/scripts/ipfs-bridge.mjs",
    "ipfs:smoke": "node web/scripts/ipfs-smoke.mjs",
    "dev": "node scripts/dev.cjs",
    "setup:dev": "node scripts/dev.cjs --setup",
    "test:dev-stack": "node --test scripts/dev-stack.test.cjs scripts/dev-launcher.test.cjs scripts/dev-ganache-storage.test.cjs scripts/dev-install-scripts.test.cjs scripts/dev-mnemonic.test.cjs scripts/dev-ganache-profile.test.cjs scripts/dev-network.test.cjs scripts/dev-network-profile.test.cjs scripts/deployment-budget.test.cjs"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "ethers": "^5.7.2",
    "hardhat": "^2.22.0",
    "ganache": "7.9.2",
    "@openzeppelin/contracts": "5.0.2"
  },
  "allowScripts": {
    "keccak": true,
    "bufferutil": true,
    "utf-8-validate": true
  }
}
