{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x0z.org/road/schemas/brick-metadata-v1.schema.json",
  "title": "0x0z Road Yellow Brick metadata v1",
  "description": "Extensible public rights object schema. Do not publish secret keys, confidential terms, private evidence, personal contacts or unpublished source material.",
  "type": "object",
  "required": [
    "standard",
    "schemaVersion",
    "objectType",
    "title",
    "creators",
    "rights",
    "media",
    "provenance"
  ],
  "properties": {
    "standard": {
      "const": "0x0z-road-ip"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "objectType": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. sound-recording, musical-work, visual-artwork, software, manuscript"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "alternativeTitles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifiers": {
      "type": "object",
      "description": "DDEX / industry identifiers are externally issued; do not invent them.",
      "properties": {
        "isrc": {
          "type": [
            "string",
            "null"
          ]
        },
        "iswc": {
          "type": [
            "string",
            "null"
          ]
        },
        "upc": {
          "type": [
            "string",
            "null"
          ]
        },
        "isni": {
          "type": [
            "string",
            "null"
          ]
        },
        "ipi": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "wallet": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "alias": {
            "type": "string"
          },
          "isni": {
            "type": "string"
          },
          "ipi": {
            "type": "string"
          },
          "shareBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "additionalProperties": true
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "genre": {
          "type": [
            "string",
            "null"
          ]
        },
        "bpm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "daw": {
          "type": "string"
        },
        "sampleRateHz": {
          "type": "number"
        },
        "bitDepth": {
          "type": "integer"
        },
        "channels": {
          "type": "integer"
        },
        "durationMs": {
          "type": "integer"
        },
        "codec": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "explicit": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "rights": {
      "type": "object",
      "required": [
        "ownershipStatus",
        "aiTraining"
      ],
      "properties": {
        "ownershipStatus": {
          "type": "string"
        },
        "territories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "licensingTermsURI": {
          "type": "string"
        },
        "termsDigest": {
          "type": "string"
        },
        "aiTraining": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "not-authorized",
                "separate-license",
                "licensed-with-terms"
              ]
            },
            "requiresAttribution": {
              "type": "boolean"
            },
            "generationRoyalties": {
              "type": "string"
            },
            "downstreamObligations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "authorization": {
            "type": "string"
          },
          "evidenceDigest": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "payout": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "shares": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "party",
              "bps"
            ],
            "properties": {
              "party": {
                "type": "string"
              },
              "bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "wallet": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "recordedAt"
      ],
      "properties": {
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceApplication": {
          "type": "string"
        },
        "authStatus": {
          "type": "string"
        },
        "evidenceURI": {
          "type": "string"
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "ipCategory": {
      "type": "string",
      "minLength": 1,
      "description": "Road's creator-selected taxonomy ID; not a legal rights determination"
    },
    "categoryLabel": {
      "type": "string",
      "description": "Human-readable Road IP category"
    },
    "evidence": {
      "type": "object",
      "description": "Unverified creator declarations and external provenance pointers",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "role",
        "name",
        "byteLength",
        "integrity",
        "access"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "integrity": {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "const": "sha2-256"
            },
            "digest": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          }
        },
        "access": {
          "type": "object",
          "required": [
            "visibility",
            "encryption"
          ],
          "properties": {
            "visibility": {
              "enum": [
                "public",
                "encrypted"
              ]
            },
            "encryption": {
              "type": "string"
            },
            "storageStatus": {
              "type": "string"
            },
            "capabilityPolicyURI": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "cid": {
          "type": [
            "string",
            "null"
          ]
        },
        "storageProviderId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
