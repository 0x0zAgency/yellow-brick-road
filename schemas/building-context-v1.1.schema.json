{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x0z.org/road/schemas/building-context-v1.1.schema.json",
  "title": "Yellow Brick Road Building context v1.1",
  "type": "object",
  "required": [
    "standard",
    "schemaVersion",
    "type",
    "name",
    "members",
    "context",
    "id",
    "status"
  ],
  "properties": {
    "standard": {
      "const": "0x0z-road-building"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "type": {
      "type": "string",
      "description": "recording-session, album, compilation, book, visual-composition, dataset, training-run, model, or new contextual form"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "role",
          "permission"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Brick contract address or local pre-mint reference"
          },
          "role": {
            "type": "string",
            "description": "Master recording, cover art, training input etc"
          },
          "permission": {
            "const": "not-granted-by-membership"
          },
          "licenseRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidenceCommitment": {
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "type": [
              "integer",
              "null"
            ]
          },
          "effectiveFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "effectiveTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "brick",
              "building"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "context": {
      "type": "object",
      "description": "Purpose, audience, restrictions, arrangement, training settings and applicable authorizations in a given Building",
      "additionalProperties": true
    },
    "manifestCommitment": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "const": "context-proposal-not-deployed"
    },
    "root": {
      "type": "string"
    },
    "files": {
      "type": "array"
    },
    "externalReferences": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
